# Copy to .env and fill in. .env is gitignored.

# Required. The SEC asks every client to identify itself with a name and contact email,
# and rate-limits or blocks whoever this names. Use your own.
SEC_USER_AGENT="Your Name your.email@example.com"

# Optional. Where raw API responses are archived. Defaults to ./raw
# PRICEDIN_RAW_DIR=/path/to/raw

# Optional. Port for the local web server. Defaults to 5000.
# PRICEDIN_PORT=5000
